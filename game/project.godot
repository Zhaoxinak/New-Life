; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="码头风云：复仇之路"
config/description="近代港口开放式策略 RPG Demo"
config/version="0.5.0"
run/main_scene="res://ui/TitleMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

PackDB="*res://autoload/PackDB.gd"
L10n="*res://autoload/L10n.gd"
UnlockScheduler="*res://systems/UnlockScheduler.gd"
GameState="*res://autoload/GameState.gd"
WorldClock="*res://autoload/WorldClock.gd"
EffectApplier="*res://systems/EffectApplier.gd"
ConditionEval="*res://systems/ConditionEval.gd"
CheckResolver="*res://systems/CheckResolver.gd"
StockEngine="*res://systems/StockEngine.gd"
EndingChecker="*res://systems/EndingChecker.gd"
ThresholdWatcher="*res://systems/ThresholdWatcher.gd"
IdleChatter="*res://systems/IdleChatter.gd"
ActionPipeline="*res://systems/ActionPipeline.gd"
ConsequenceText="*res://systems/ConsequenceText.gd"
PromotionSystem="*res://systems/PromotionSystem.gd"
WeatherSystem="*res://systems/WeatherSystem.gd"
EventScheduler="*res://systems/EventScheduler.gd"
EventStaging="*res://systems/EventStaging.gd"
SaveSystem="*res://autoload/SaveSystem.gd"
GameFlow="*res://autoload/GameFlow.gd"
SfxPlayer="*res://autoload/SfxPlayer.gd"
VoicePlayer="*res://autoload/VoicePlayer.gd"
GameSettings="*res://autoload/GameSettings.gd"
TipSystem="*res://autoload/TipSystem.gd"
QuestGuide="*res://autoload/QuestGuide.gd"
NpcScheduler="*res://systems/NpcScheduler.gd"
RelationJournal="*res://systems/RelationJournal.gd"
NpcWorldSim="*res://systems/NpcWorldSim.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

