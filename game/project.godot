; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="暗潮"
config/description="清光绪十六年天津 · 内容平台战役 Demo"
config/version="1.23.0-display-2k4k"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

LogGuard="*res://autoload/LogGuard.gd"
PackDB="*res://autoload/PackDB.gd"
L10n="*res://autoload/L10n.gd"
DomainBus="*res://autoload/DomainBus.gd"
RunState="*res://autoload/RunState.gd"
SaveSystem="*res://autoload/SaveSystem.gd"
ConditionEval="*res://systems/ConditionEval.gd"
EffectApplier="*res://systems/EffectApplier.gd"
TickPipeline="*res://systems/TickPipeline.gd"
DialogueRunner="*res://systems/DialogueRunner.gd"
RouteMutex="*res://systems/RouteMutex.gd"
PromotionSystem="*res://systems/PromotionSystem.gd"
FailureScanner="*res://systems/FailureScanner.gd"
RandomScanner="*res://systems/RandomScanner.gd"
FinanceService="*res://systems/FinanceService.gd"
MeetingSystem="*res://systems/MeetingSystem.gd"
ChatterSystem="*res://systems/ChatterSystem.gd"
KairoStyle="*res://ui/KairoStyle.gd"
DisplaySettings="*res://autoload/DisplaySettings.gd"

[debug]

file_logging/enable_file_logging=true
gdscript/warnings/inference_on_variant=1
gdscript/warnings/treat_warnings_as_errors=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1920
window/size/window_height_override=1080
window/dpi/allow_hidpi=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"

[internationalization]

locale/fallback="zh_CN"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
